<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>XCOM2Launcher</RootNamespace>
    <AssemblyName>XCOM2 Launcher</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion> 
    <StartupObject>XCOM2Launcher.Program</StartupObject>
    <ApplicationIcon>Resources\xcom.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn />
    <WarningsAsErrors />
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn />
    <WarningsAsErrors />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastColoredTextBox.NET10" Version="2.16.26.9180" />
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.2" PrivateAssets="all" />
    <PackageReference Include="IndexRange" Version="1.1.1" />
    <PackageReference Include="log4net" Version="3.5.0" />
    <PackageReference Include="Markdown" Version="2.2.1" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="11.0.0" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Core" Version="1.1.5" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="ObjectListView.Repack.NET6Plus" Version="2.9.5" />
    <PackageReference Include="Semver" Version="3.0.0" />
    <PackageReference Include="Sentry" Version="6.12.1" />
    <PackageReference Include="Steamworks.NET.AnyCPU" Version="2026.165.3" />
    <PackageReference Include="System.Collections.Immutable" Version="11.0.0" />
    <PackageReference Include="System.IO.Pipelines" Version="11.0.0" />
    <PackageReference Include="System.Reflection.Metadata" Version="11.0.0" />
    <PackageReference Include="System.Text.Encodings.Web" Version="11.0.0" />
    <PackageReference Include="System.Text.Json" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UserElements\AutoCompleteTextBox.cs"><SubType>Component</SubType></Compile>
    <Compile Update="UserElements\CueComboBox.cs"><SubType>Component</SubType></Compile>
    <Compile Update="UserElements\CueTextBox.cs"><SubType>Component</SubType></Compile>
    <None Update="Classes\Log4Net\log4net.xsd"><SubType>Designer</SubType></None>
    <None Update="log4net.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\AML-Logo.png" />
    <Content Include="Resources\document-save-5.png" />
    <Content Include="Resources\X2-Logo.png" />
    <Content Include="Resources\xcom.ico" />
  </ItemGroup>

  <ItemGroup Label="Compile items now included by globbing that were not in the original project file">
    <Compile Remove="Classes\XCOM\old\Config.cs" />
  </ItemGroup>

</Project>